#!/data/data/com.termux/files/usr/bin/bash
termux-notification \
    --id adbpair \
    --title 'Input' \
    --content 'HOST[:PORT] [PAIRING CODE]' \
    --priority high \
    --ongoing \
    --button1 Enter \
    --button1-action 'adb pair "$REPLY"' \
    --button2 Settings \
    --button2-action 'am start -a android.settings.APPLICATION_DEVELOPMENT_SETTINGS'
